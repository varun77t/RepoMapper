# Copy to .env and adjust. Docker Compose reads this file automatically.

POSTGRES_USER=repomap
POSTGRES_PASSWORD=repomap
POSTGRES_DB=repomap
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Browser origins allowed to call the API. Must include the frontend's port.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Running the backend outside Docker against the Compose database:
# DATABASE_URL=postgresql+psycopg://repomap:repomap@localhost:5432/repomap

# --- Ingestion limits ---
MAX_FILES=5000
MAX_FILE_BYTES=1000000
CLONE_TIMEOUT_S=120

# --- Phase 5 (not implemented) ---
ENABLE_LLM_SUMMARIES=false
GEMINI_API_KEY=
